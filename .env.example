# GlucoTwin AI - Environment Configuration Example
# Copy this file to .env for local overrides if needed.
# This proof of concept is fully runnable without paid services or secrets.

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Data Mode: 'synthetic' (default) or 'custom'
DATA_MODE=synthetic

# Forecast Horizon (minutes)
FORECAST_HORIZON_MINUTES=120

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=*
